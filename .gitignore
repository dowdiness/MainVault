# Ignore node modules
node_modules

# Quartz build artifacts and dependencies
quartz/node_modules/
quartz/.quartz-cache/
quartz/public/
quartz/.github/

# https://www.make.md/
.makemd

# Exclude Obsidian's workspace cache
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Exclude MacOS settings and caches
.trash/
.DS_Store

# Excude obsidian plugins data
.obsidian/plugins/**/*.js
.obsidian/plugins/obsidian-local-rest-api/data.json
.obsidian/plugins/mcp-tools
.obsidian/plugins/yolo
.env

# Ignore Smart Environment folder
.smart-env

# Smart Composer AI cache/index files
.smtcmp_vector_db.tar.gz
.smtcmp_json_db/
